GEMINI_API_KEY=your_gemini_api_key_here
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# Token cho trang chỉ-xem của người thân (/family) — không điều khiển được gì.
# Để trống thì server tự sinh và ghi lại vào đây.
FAMILY_TOKEN=
# Gửi SMS báo người thân khi khẩn cấp (core/notifier.py) — lấy tại tài khoản eSMS.vn.
# Số điện thoại nhận tin cấu hình trong config/settings.yaml (caregiver.phones).
ESMS_API_KEY=
ESMS_SECRET_KEY=
