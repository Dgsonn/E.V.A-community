GEMINI_API_KEY=your_gemini_api_key_here
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# Bắt buộc để gọi bất kỳ /api/* nào của dashboard (xem core/web_interface.py) — để trống thì
# server tự sinh 1 token ngẫu nhiên lúc khởi động và ghi lại vào đây, không cần tự điền.
DASHBOARD_TOKEN=
# Mã PIN 4 số để ghép nối dashboard lần đầu (route /api/pair) thay vì dán DASHBOARD_TOKEN dài —
# để trống thì server tự sinh và ghi lại vào đây, in ra log lúc khởi động.
DASHBOARD_PIN=
# Token riêng cho trang chỉ-xem của người thân (/family) — quyền hạn hẹp hơn DASHBOARD_TOKEN
# nhiều, không điều khiển được gì. Để trống thì server tự sinh và ghi lại vào đây.
FAMILY_TOKEN=
